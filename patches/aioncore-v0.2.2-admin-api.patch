+// ---------------------------------------------------------------------------
+// PUT /api/admin/users/{id}/status — disable / enable
+// ---------------------------------------------------------------------------
+
+#[tokio::test]
+async fn admin_disables_and_reenables_guest() {
+    let app = setup().await;
+    let resp = app
+        .clone()
+        .oneshot(request_for_user(
+            ADMIN_ID,
+            "PUT",
